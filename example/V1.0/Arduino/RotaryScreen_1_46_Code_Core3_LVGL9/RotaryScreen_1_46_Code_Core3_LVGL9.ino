/*---------------------------------------------------------------
 * Encoder push-button interrupt
 * Capture short button events without performing UI work in the ISR.
 *--------------------------------------------------------------*/
/**
 * @brief Record an accepted encoder push-button edge.
 *
 * Applies a time-based debounce check, updates the shared press state,
 * and counts clicks for later single- or double-click classification.
 * UI transitions are deferred to encTask() because they are not safe
 * operations for an interrupt service routine.
 *
 * @note Parameters: None; the function is installed as a GPIO ISR.
 * @return Nothing.
 * @note Called on each falling edge detected on SWITCH_PIN.
 */
void IRAM_ATTR buttonISR() {
  static unsigned long lastInterruptTime = 0;
  unsigned long interruptTime = millis();

  // Ignore mechanical bounce until the active debounce interval expires.
  if (interruptTime - lastInterruptTime > debounceTime) {
    debounceTime = 40;
    if (digitalRead(SWITCH_PIN)) {
      pressFlag = false;
    } else {
      pressFlag = true;
      lastPressTime = interruptTime;
      clickCount++;
    }
  }
  lastInterruptTime = interruptTime;
} 

/*---------------------------------------------------------------
 * LVGL display output
 * Transfer rendered RGB565 regions to the LCD through SPI DMA.
 *--------------------------------------------------------------*/
/**
 * @brief Flush an LVGL render region to the ST77961 display.
 *
 * Ends any outstanding LovyanGFX write transaction, submits the requested
 * pixel rectangle through DMA, and releases LVGL to continue rendering.
 *
 * @param disp LVGL display that requested the transfer.
 * @param area Inclusive screen coordinates of the region to update.
 * @param px_map RGB565 pixel data generated by LVGL.
 * @return Nothing.
 * @note Called by LVGL whenever a rendered area must reach the panel.
 */
void my_disp_flush(lv_display_t *disp, const lv_area_t *area, uint8_t *px_map) {
  // DMA owns the transfer that follows, so close the earlier transaction.
  if (gfx.getStartCount() > 0) {
    gfx.endWrite();
  }
  gfx.pushImageDMA(area->x1, area->y1, area->x2 - area->x1 + 1, area->y2 - area->y1 + 1, (lgfx::rgb565_t *)px_map);

  lv_display_flush_ready(disp);
}

/*---------------------------------------------------------------
 * LVGL touch input
 * Translate CST816T samples into LVGL pointer states and coordinates.
 *--------------------------------------------------------------*/
/**
 * @brief Provide the latest touch sample to LVGL.
 *
 * Reports a pressed state and valid coordinates when the CST816T has new
 * data. A zero-zero sample is discarded because the controller may use it
 * as an invalid reading. Otherwise the input is reported as released.
 *
 * @param indev LVGL input device requesting data; unused by this driver.
 * @param data Destination for the pointer state and coordinates.
 * @return Nothing.
 * @note Called periodically by LVGL through its input-device handler.
 */
void my_touchpad_read(lv_indev_t *indev, lv_indev_data_t *data) {
  (void)indev;
  
  // The CST816T library supplies coordinates directly to the LVGL driver.
  //if ( gfx.getTouch( &touchX, &touchY ) ) {
  if(touch.available())
  {
    data->state = LV_INDEV_STATE_PRESSED;

    // Do not overwrite LVGL's last valid position with an invalid sample.
    if(touch.x == 0 && touch.y == 0)
      return ;
    data->point.x = touch.x;

    data->point.y = touch.y;
    
#ifdef DEBUG_PRINT
    Serial.print( "Data x " );
    Serial.println( data->point.x );
    Serial.print( "Data y " );
    Serial.println( data->point.y );
#endif
  }
  else
  {
    data->state = LV_INDEV_STATE_RELEASED;
  }
}

/*---------------------------------------------------------------
 * LCD backlight control
 * Start an 8-bit PWM channel at a visible mid-level brightness.
 *--------------------------------------------------------------*/
/**
 * @brief Initialize the LCD backlight PWM output.
 *
 * Attaches SCREEN_BACKLIGHT_PIN to the shared 5 kHz PWM configuration and
 * starts the display at 50 percent brightness.
 *
 * @note Parameters: None.
 * @return Nothing.
 * @note Called once near the end of setup(), after the UI is initialized.
 */
void initBacklight() {
  ledcAttach(SCREEN_BACKLIGHT_PIN, pwmFreq, pwmResolution);
  ledcWrite(SCREEN_BACKLIGHT_PIN, (50 * 255) / 100);
}

/*---------------------------------------------------------------
 * Encoder button actions
 * Enter the selected detail page or return to the main menu.
 *--------------------------------------------------------------*/
/**
 * @brief Open the detail page selected on the main menu.
 *
 * Maps menu indexes 0, 1, and 2 to the Volume, Bulb, and Light screens.
 * The action is ignored when another screen is already active.
 *
 * @note Parameters: None.
 * @return Nothing.
 * @note Called by encTask() after a single click is confirmed.
 */
void performClickAction()
{
  current_screen = lv_screen_active();
  if(current_screen == ui_Screen1)
  {
    if(current_screen == ui_Screen1)
    {
      if(screen1_index == 0)
      {
        _ui_screen_change(&ui_Screen2, LV_SCR_LOAD_ANIM_FADE_ON, 200 ,0, &ui_Screen2_screen_init);
      }
      else if(screen1_index == 1)
      {
        _ui_screen_change(&ui_Screen3, LV_SCR_LOAD_ANIM_FADE_ON, 200 ,0, &ui_Screen3_screen_init);
      }
      else if(screen1_index == 2)
      {
        _ui_screen_change(&ui_Screen4, LV_SCR_LOAD_ANIM_FADE_ON, 200 ,0, &ui_Screen4_screen_init);
      }
    }
  }
}

/**
 * @brief Return from a detail page to the main menu.
 *
 * Accepts a double click only on the Volume, Bulb, or Light screen and
 * applies the same short fade transition used by touch navigation.
 *
 * @note Parameters: None.
 * @return Nothing.
 * @note Called by encTask() as soon as two clicks are detected.
 */
void performDoubleClickAction()
{
  current_screen = lv_screen_active();
  if(current_screen == ui_Screen2 || current_screen == ui_Screen3 || current_screen == ui_Screen4)
  {

    _ui_screen_change(&ui_Screen1, LV_SCR_LOAD_ANIM_FADE_ON, 200 ,0, &ui_Screen1_screen_init);
      
  }
}

/*---------------------------------------------------------------
 * Arc value-change callbacks
 * Keep percentage labels and physical PWM outputs synchronized with UI.
 *--------------------------------------------------------------*/
/**
 * @brief Update the displayed Volume percentage.
 *
 * Reads the changed arc value and formats a fixed-width percentage label.
 * This screen is a UI demonstration and does not control audio hardware.
 *
 * @param e LVGL value-change event generated by the Volume arc.
 * @return Nothing.
 * @note Called by LVGL when ui_VolumeArc reports LV_EVENT_VALUE_CHANGED.
 */
static void volume_arc_event_cb(lv_event_t *e)
{
    lv_obj_t *arc = lv_event_get_target_obj(e);
    int value = lv_arc_get_value(arc);
    
    // Preserve label alignment by adding a leading space below 100 percent.
    char volText[8];
    if (value == 100) {
        snprintf(volText, sizeof(volText), "%d%%", value);
    } else {
        snprintf(volText, sizeof(volText), " %d%%", value);
    }
    lv_label_set_text(ui_VolNum, volText);
}

/**
 * @brief Update the Bulb percentage and its PWM duty cycle.
 *
 * Converts the arc's 0-to-100 value into the 0-to-255 range required by
 * the 8-bit PWM output on BULB_LED_PIN.
 *
 * @param e LVGL value-change event generated by the Bulb arc.
 * @return Nothing.
 * @note Called by LVGL when ui_BulbArc reports LV_EVENT_VALUE_CHANGED.
 */
static void bulb_arc_event_cb(lv_event_t *e)
{
    lv_obj_t *arc = lv_event_get_target_obj(e);
    int value = lv_arc_get_value(arc);
    
    // Preserve label alignment by adding a leading space below 100 percent.
    char bulbText[8];
    if (value == 100) {
        snprintf(bulbText, sizeof(bulbText), "%d%%", value);
    } else {
        snprintf(bulbText, sizeof(bulbText), " %d%%", value);
    }
    lv_label_set_text(ui_BulbNum, bulbText);
    
    // Scale the UI percentage to the configured 8-bit PWM range.
